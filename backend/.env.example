# ==============================================================================
# GATEForge Environment Configuration
# Copy this file to backend/.env and populate with your credentials.
# NEVER commit real API keys or credentials to version control.
# ==============================================================================

# Runtime Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection URI (Falls back to clean in-memory database if unavailable)
MONGODB_URI=mongodb://127.0.0.1:27017/gateforge

# Maximum HTTP Request Body Size in bytes (Default: 2097152 = 2MB)
MAX_BODY_SIZE_BYTES=2097152

# AI Provider Configuration
# Groq (Ultra-Fast 500+ tok/s LPUs):
# Obtain a free Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile

# AI Client Operational Limits
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_CONCURRENT_REQUESTS=2
AI_MIN_REQUEST_INTERVAL_MS=1000
